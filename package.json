{
  "name": "neureed",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "postinstall": "test -f prisma/schema.prisma && prisma generate || echo 'Skipping prisma generate (schema not found)'",
    "db:generate": "npm exec prisma generate",
    "db:push": "npm exec prisma db push",
    "db:migrate": "npm exec prisma migrate dev",
    "db:studio": "npm exec prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm exec prisma migrate reset",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@rowanmanning/feed-parser": "^2.1.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.11",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "he": "^1.2.0",
    "iconv-lite": "^0.7.0",
    "ioredis": "^5.8.2",
    "jsdom": "^27.2.0",
    "lucide-react": "^0.555.0",
    "next": "^16.0.4",
    "next-auth": "^5.0.0-beta.25",
    "node-cron": "^4.2.1",
    "onnxruntime-web": "^1.23.2",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@next/bundle-analyzer": "^16.0.4",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/nextjs-vite": "^10.0.8",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/he": "^1.2.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "4.0.14",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/ui": "^4.0.14",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "^16.0.4",
    "eslint-plugin-storybook": "^10.0.8",
    "happy-dom": "^20.0.10",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "storybook": "^10.0.8",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.14"
  },
  "optionalDependencies": {
    "playwright": "^1.57.0"
  }
}
